<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>AutoCMEX</RootNamespace>
    <!-- Catch compiler-mismatch issues with the Introspection generator as early as possible -->
    <WarningsAsErrors>CS9057</WarningsAsErrors>
    <!-- Required for some nuget packages to work -->
    <!-- godotengine/godot/issues/42271#issuecomment-751423827 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- To show generated files -->
    <!-- <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles> -->
    <!--
      <CompilerGeneratedFilesOutputPath>.generated</CompilerGeneratedFilesOutputPath>
    -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Title>AutoCMEX</Title>
    <!-- Version comes from project.godot (application/config/version) - the single source of truth. -->
    <_GodotProjectText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/project.godot'))</_GodotProjectText>
    <_GodotVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_GodotProjectText)', 'config/version="([^"]+)"').Groups[1].Value)</_GodotVersion>
    <Version>$(_GodotVersion)</Version>
    <Description>AutoCMEX</Description>
    <Copyright>© 2026 AutoCMEX</Copyright>
    <Authors>AutoCMEX</Authors>
    <Company>AutoCMEX</Company>

    <SkipTests Condition="'$(SKIP_TESTS)' != ''">true</SkipTests>
    <RunTests>false</RunTests>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      帮助内容生成链：docs/help/**/*.md 是唯一内容源，
      构建期由 tools/HelpContentGenerator 预渲染成 C# 常量，运行时零解析、零文件 IO。
    -->
    <HelpGeneratorProject>$(MSBuildProjectDirectory)/tools/HelpContentGenerator/HelpContentGenerator.csproj</HelpGeneratorProject>
    <HelpContentDocsDir>$(MSBuildProjectDirectory)/docs/help</HelpContentDocsDir>
    <HelpContentAssetsDir>$(MSBuildProjectDirectory)/src/assets/help</HelpContentAssetsDir>
    <HelpContentGeneratedFile>$(MSBuildProjectDirectory)/src/core/help/Generated/HelpContent.Generated.cs</HelpContentGeneratedFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 增量输入：帮助正文。只作为生成输入，不进编译 -->
    <HelpContentSource Include="$(HelpContentDocsDir)/**/*.md" />
    <!-- 增量输入：帮助图片。图片增删必须触发重生成，否则「补图后帮助仍不显示」 -->
    <HelpContentImage Include="$(HelpContentAssetsDir)/images/**/*" />
    <!-- 生成器工程在 tools/ 下：默认 Compile 通配会把它编进游戏程序集，必须剔除 -->
    <Compile Remove="tools/**/*.cs" />
    <!--
      生成物已存在时先从默认 Compile 通配里剔除（求值期），再由目标显式 Include；
      只在目标里 Remove 会对同一文件重复包含，产生 CS2002 告警。
    -->
    <Compile Remove="src/core/help/Generated/**/*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Six Labors 许可证：assembly-scoped Community key（仅对 AutoCMEX 程序集有效），公开仓库可提交。
         ImageSharp 3.2.0 起在构建期校验该文件，缺失或无效时 Release / ExportRelease 构建直接失败。 -->
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory)sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

  <PropertyGroup Condition="('$(Configuration)' == 'Debug' or '$(Configuration)' == 'ExportDebug') and '$(SkipTests)' != 'true' ">
    <RunTests>true</RunTests>
    <DefineConstants>$(DefineConstants);RUN_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Production dependencies go here! -->
    <PackageReference Include="Chickensoft.AutoInject" Version="2.13.10" PrivateAssets="all" />
    <PackageReference Include="Chickensoft.Introspection" Version="3.0.3" />
    <PackageReference
      Include="Chickensoft.Introspection.Generator"
      Version="3.0.3"
      PrivateAssets="all"
      OutputItemType="analyzer"
    />
    <PackageReference Include="Chickensoft.GameTools" Version="3.1.22" />
    <PackageReference Include="Chickensoft.GodotNodeInterfaces" Version="3.0.16" />
    <PackageReference Include="Chickensoft.Log" Version="2.0.0" />
    <PackageReference Include="Chickensoft.Log.Godot" Version="1.0.80" />
    <PackageReference Include="Chickensoft.LogicBlocks" Version="6.0.0" />
    <PackageReference Include="Chickensoft.Sync" Version="3.0.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <!-- GIF 帧解码（信息板块：符卡 GIF 集展示）；纯托管实现，不引入原生资产 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunTests)' == 'true'">
    <!-- Test dependencies go here! -->
    <!-- Dependencies added here will not be included in release builds. -->
    <PackageReference Include="Chickensoft.GoDotTest" Version="2.0.35" />
    <!-- Used to drive test scenes when testing visual code -->
    <PackageReference Include="Chickensoft.GodotTestDriver" Version="3.1.72" />
    <!-- Bring your own assertion library for tests! -->
    <!-- We're using Shouldly for this example, but you can use anything. -->
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <!-- Moq is the standard mocking library used in GameDemo. -->
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunTests)' != 'true'">
    <Compile Remove="test/**/*.cs" />
    <None Remove="test/**/*" />
    <EmbeddedResource Remove="test/**/*" />
  </ItemGroup>

  <!--
    帮助内容生成链。三个目标分工：
      BuildHelpGenerator         → 构建生成器工具（固定 Configuration=Debug）
      GenerateHelpContent        → 增量执行生成器；md 或图片更新时重生成，失败即构建失败
      IncludeHelpContentGenerated → 无条件把产物加入编译（增量命中时上一条会被跳过）
  -->
  <Target Name="BuildHelpGenerator">
    <!--
      RemoveProperties="Configuration" 是为了让命令行全局属性 -c ExportRelease 不压制
      生成器自己的 Configuration=Debug（全局属性优先级高于 Properties）。
    -->
    <MSBuild
      Projects="$(HelpGeneratorProject)"
      Targets="Restore;Build"
      RemoveProperties="Configuration"
      Properties="Configuration=Debug"
    >
      <Output TaskParameter="TargetOutputs" ItemName="HelpGeneratorAssembly" />
    </MSBuild>
  </Target>

  <Target
    Name="GenerateHelpContent"
    DependsOnTargets="BuildHelpGenerator"
    BeforeTargets="BeforeCompile"
    Inputs="@(HelpContentSource);@(HelpContentImage);@(HelpGeneratorAssembly);$(MSBuildProjectDirectory)/project.godot"
    Outputs="$(HelpContentGeneratedFile)"
  >
    <Exec Command="dotnet &quot;@(HelpGeneratorAssembly)&quot; --input &quot;$(HelpContentDocsDir)&quot; --output &quot;$(HelpContentGeneratedFile)&quot; --assets &quot;$(HelpContentAssetsDir)&quot;" />
  </Target>

  <Target
    Name="IncludeHelpContentGenerated"
    DependsOnTargets="GenerateHelpContent"
    BeforeTargets="BeforeCompile"
  >
    <ItemGroup>
      <Compile Include="$(HelpContentGeneratedFile)" />
    </ItemGroup>
  </Target>

  <!-- Fail fast if the version cannot be read from project.godot. -->
  <Target Name="EnsureVersion" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(_GodotVersion)' == ''"
      Text="project.godot has no config/version; cannot derive the assembly version."
    />
    <Error
      Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_GodotVersion)', '^[0-9]+(.[0-9]+)*$'))"
      Text="project.godot config/version '$(_GodotVersion)' is not numeric (expected e.g. 1.2.3)."
    />
  </Target>
</Project>
