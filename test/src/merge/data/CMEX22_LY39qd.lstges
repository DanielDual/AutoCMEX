3,{"$type":".General.Folder, LuaSTGEditorSharp","Attributes":[{"attrCap":"Name","attrInput":"cast_ef_out","EditWindow":""}],"AttributeCount":1,"IsExpanded":false}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local cmex22_boss_cast_ef_unit = Class(object)\r\nfunction cmex22_boss_cast_ef_unit:init(x, y, v, a, lifetime, size, img, r, g, b)\r\n    self.x, self.y = x, y\r\n    self.group = GROUP_GHOST\r\n    self.layer = LAYER_ENEMY + 30\r\n    self.img = img or \"img_void\"\r\n    self.rot = ran:Float(0, 360)\r\n    self.lifetime = lifetime\r\n    self.omiga = ran:Float(0.8, 1.2) * ran:Sign()\r\n    self.hscale, self.vscale = size, size\r\n    self.bound = false\r\n    self._r = r\r\n    self._g = g\r\n    self._b = b\r\n    task.New(self, function()\r\n        local s, al, i, l = size, 125, 0, v * lifetime\r\n        local _s, _al, _i, _l = -ran:Float(1, 3) * size / lifetime, -125 / lifetime, 90 / lifetime, 0\r\n        for j = 1, lifetime do\r\n            self.x = x + l * cos(a) * sin(i)\r\n            self.y = y + l * sin(a) * sin(i)\r\n            self.hscale = s\r\n            s = s + _s\r\n            al = al + _al\r\n            i = i + _i\r\n            task.Wait(1)\r\n        end\r\n        Del(self)\r\n    end)\r\nend\r\n\r\nfunction cmex22_boss_cast_ef_unit:frame()\r\n    task.Do(self)\r\n    if self.timer == self.lifetime then\r\n        Del(self)\r\n    end\r\nend\r\n\r\nfunction cmex22_boss_cast_ef_unit:render()\r\n    if self.timer > self.lifetime - 15 then\r\n        SetImageState(self.img, \"mul+add\", Color(max(0, 125 * (self.lifetime - self.timer - 1) / 15), self._r, self._g, self._b))\r\n    else\r\n        SetImageState(self.img, \"mul+add\", Color(125, self._r, self._g, self._b))\r\n    end\r\n    DefaultRenderFunc(self)\r\nend\r\n\r\nlocal cmex22_boss_cast_ef_out = Class(object)\r\nfunction cmex22_boss_cast_ef_out:init(x, y, img, r, g, b, sound)\r\n    self.x = x\r\n    self.y = y\r\n    self.img = \"boss_shockwave\" -- \"boss_charge\"\r\n    self.unitimg = img\r\n    self.group = GROUP_GHOST\r\n    self.layer = LAYER_ENEMY + 50\r\n    self._r = r\r\n    self._g = g\r\n    self._b = b\r\n    self.hscale, self.vscale = 0, 0\r\n    if sound and sound ~= \"\" then\r\n        PlaySound(sound, 1, 0, false)\r\n    end\r\nend\r\n\r\nlocal boss_cast_ef_out_range = { { 50, 150 }, { 150, 250 }, { 200, 350 } }\r\nfunction cmex22_boss_cast_ef_out:frame()\r\n    local angle, lifetime, l\r\n    if self.timer < 15 then\r\n        for i = 1, 3 do\r\n            angle = ran:Float(0, 360)\r\n            lifetime = ran:Int(30, 45)\r\n            l = ran:Float(unpack(boss_cast_ef_out_range[i]))\r\n            New(cmex22_boss_cast_ef_unit, self.x, self.y,\r\n                    l / lifetime, angle + 180, lifetime, ran:Float(0.1, 0.5), self.unitimg, self._r, self._g, self._b)\r\n        end\r\n    end\r\n    self.hscale = self.timer * 0.025\r\n    self.vscale = self.timer * 0.025\r\n    if self.timer > 59 then\r\n        Del(self)\r\n    end\r\nend\r\n\r\nfunction cmex22_boss_cast_ef_out:render()\r\n    SetImageState(self.img, \"mul+add\", Color(240 - self.timer * 4, self._r, self._g, self._b))\r\n    object.render(self)\r\nend","EditWindow":"code"}],"AttributeCount":1}
