5,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local pi = 180\r\nlocal function easeInSine(x)\r\n    return 1 - cos(x * pi / 2)\r\nend\r\nlocal function easeOutSine(x)\r\n    return sin(x * pi / 2);\r\nend\r\nlocal function easeInOutSine(x)\r\n    return (1 - cos(x * pi)) / 2;\r\nend\r\nself.hscale = 0.9\r\nself.vscale = 0.9","EditWindow":"code"}],"AttributeCount":1}
